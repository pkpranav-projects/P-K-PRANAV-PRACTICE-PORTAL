    query GetCategories($categorySlug: String, $num: Int) {
  categories(slug: $categorySlug) {
    id
    title
    slug
    cards(num: $num) {
      ...CardDetailFragment
    }
  }
  mostRecentCard {
    ...CardDetailFragment
    progress
  }
  allProgress
}
    fragment CardDetailFragment on CardNode {
  id
  img
  title
  slug
  categorySlug
  description
  createdAt
  lastModified
  paidOnly
  published
  numChapters
  numItems
  codingChallengeInfo {
    startDate
    containsPremium
    canApplyTimeTravelTicket
  }
  shareEvent {
    startDate
    endDate
    hasUserSharedEvent
  }
  valueAddedContent {
    name
    slug
    description
    isActive
    hasAccess
    pricing {
      price
      originalPrice
